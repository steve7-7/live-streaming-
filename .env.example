# ── Streamly environment ──────────────────────────────────────────────
# Copy to `.env` and adjust. Only `VITE_`-prefixed vars reach the client.

# Phase 1 API (local SQLite; use a secret of at least 32 characters)
DATABASE_URL="file:./data/streamly.db"
API_PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-this-with-a-different-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# REST API (Phase 1). Keep disabled to use built-in demo fixtures.
# /api uses the Vite proxy locally and avoids browser-facing localhost URLs.
VITE_API_URL=/api
VITE_API_TIMEOUT_MS=10000
VITE_ENABLE_API=false

# Realtime gateway (blank origin uses the current host through Vite's WS proxy)
VITE_ENABLE_REALTIME=false
VITE_WS_URL=

# Browser media + LiveKit SFU (Phase 2 — real media)
VITE_ENABLE_MEDIA=false
VITE_LIVEKIT_URL=

# Error reporting: Sentry is initialised only when a DSN is set
VITE_SENTRY_DSN=

# Forward analytics events to a provider (Phase 4)
VITE_ENABLE_ANALYTICS=false
