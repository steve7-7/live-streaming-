# ── Streamly environment ──────────────────────────────────────────────
# Copy to `.env` and adjust. Only `VITE_`-prefixed vars reach the client.

# REST API base URL (Phase 1 — backend)
VITE_API_URL=http://localhost:4000

# Realtime gateway URL (Phase 3 — WebSocket)
VITE_WS_URL=ws://localhost:4000

# LiveKit SFU URL (Phase 2 — real media)
VITE_LIVEKIT_URL=

# Error reporting: Sentry is initialised only when a DSN is set
VITE_SENTRY_DSN=

# Forward analytics events to a provider (Phase 4)
VITE_ENABLE_ANALYTICS=false
